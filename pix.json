{
  "optimizer": {
    "caveman": "full",
    "ponytail": "full"
  },
  "$version": 1,
  "notify": {
    "sound": "message"
  },
  "edit": {
    "rejectNewSyntaxErrors": true
  },
  "collapse": {
    "tools": {
      "bash": true,
      "read": true,
      "write": true,
      "edit": true,
      "find": true,
      "grep": true
    }
  },
  "extensions": {
    "disabled": [
      "@xynogen/pix-footer",
      "@xynogen/pix-welcome"
    ]
  }
}
