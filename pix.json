{
  "optimizer": {
    "caveman": "full",
    "ponytail": "full"
  },
  "$version": 1,
  "notify": {
    "sound": "message"
  },
  "edit": {
    "rejectNewSyntaxErrors": true
  },
  "collapse": {
    "enabled": true,
    "delaySec": 10,
    "tools": {
      "bash": true,
      "read": true,
      "write": true,
      "edit": true,
      "find": true,
      "grep": true
    }
  }
}
