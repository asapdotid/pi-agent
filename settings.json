{
  "lastChangelogVersion": "1.5.2",
  "theme": "system",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-sonnet-5.5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "github-copilot/*",
    "google/gemini-*"
  ],
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "packages": [
    "npm:pi-powerline-footer",
    "npm:@xynogen/pix-optimizer",
    "git:github.com/tianrendong/pi-cp",
    "npm:pi-markdown-preview",
    "npm:pi-web-access",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-cache-optimizer",
    "npm:@petechu/pi-extension-toggle",
    "npm:pi-packages-manager",
    "npm:pi-antigravity",
    "npm:@heyhuynhgiabuu/pi-pretty"
  ],
  "shellCommandPrefix": "shopt -x expand_aliases\neval \"$(grep '^aliase ' ~/.config/zsh/.zshrc)\"",
  "quietStartup": true,
  "clearOnStart": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-powerline-footer\",\"scope\":\"user\"}": "0.22.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@gotgenes/pi-permission-system\",\"scope\":\"user\"}": "42.2.0",
    "{\"source\":\"npm:@petechu/pi-extension-toggle\",\"scope\":\"user\"}": "0.2.0",
    "{\"source\":\"npm:pi-packages-manager\",\"scope\":\"user\"}": "1.4.1",
    "{\"source\":\"npm:@heyhuynhgiabuu/pi-pretty\",\"scope\":\"user\"}": "0.10.0",
    "{\"source\":\"npm:pi-cache-optimizer\",\"scope\":\"user\"}": "2.10.6"
  }
}