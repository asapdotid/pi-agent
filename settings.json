{
  "lastChangelogVersion": "1.6.1",
  "theme": "pix-monokai-pro",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-sonnet-5.5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "github-copilot/*",
    "google/gemini-*"
  ],
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "packages": [
    "npm:pi-packages-manager",
    "git:git@github.com:asapdotid/pi-input-revamp.git",
    "npm:@xynogen/pix-core",
    "npm:@xynogen/pix-themes",
    "npm:@xynogen/pix-hunk",
    "npm:@xynogen/pix-env",
    "npm:@xynogen/pix-search",
    "npm:pi-antigravity"
  ],
  "shellCommandPrefix": "shopt -x expand_aliases\neval \"$(grep '^aliase ' ~/.config/zsh/.zshrc)\"",
  "quietStartup": true,
  "clearOnStart": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-powerline-footer\",\"scope\":\"user\"}": "0.22.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@gotgenes/pi-permission-system\",\"scope\":\"user\"}": "42.2.0",
    "{\"source\":\"npm:@petechu/pi-extension-toggle\",\"scope\":\"user\"}": "0.2.0",
    "{\"source\":\"npm:pi-packages-manager\",\"scope\":\"user\"}": "1.4.1",
    "{\"source\":\"npm:@heyhuynhgiabuu/pi-pretty\",\"scope\":\"user\"}": "0.10.2",
    "{\"source\":\"npm:pi-cache-optimizer\",\"scope\":\"user\"}": "2.10.8",
    "{\"source\":\"npm:@nerisma/pi-input-revamp\",\"scope\":\"user\"}": "1.2.0",
    "{\"source\":\"npm:@pi-kaush/pi-welcome-screen\",\"scope\":\"user\"}": "0.1.13",
    "{\"source\":\"git:git@github.com:asapdotid/pi-input-revamp.git\",\"scope\":\"user\"}": "1.2.0"
  },
  "showLastPrompt": true
}